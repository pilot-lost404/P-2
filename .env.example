# Copy to `.env` and fill in for local development. All are optional: with no
# Supabase values the app runs in local mode (progress in this browser only).

# Supabase (server functions verify the JWT against these). Never use a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public origin used for canonical URLs and sitemap entries, e.g. https://example.org
# Leave empty to keep canonical/sitemap URLs relative to the serving origin.
VITE_SITE_URL=
